# CreatorOS environment variables
# Keep real secrets OUT of GitHub. Put them in your hosting provider's environment settings.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App security
# TOKEN_ENCRYPTION_KEY should be a long random secret used to encrypt platform tokens.
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Weekly email reports (Resend)
RESEND_API_KEY=
REPORT_FROM_EMAIL=

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: https://YOUR-DOMAIN.com/api/oauth/youtube/callback
YOUTUBE_REDIRECT_URI=

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Example: https://YOUR-DOMAIN.com/api/oauth/tiktok/callback
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.list

# Meta / Instagram / Facebook OAuth
META_APP_ID=
META_APP_SECRET=
# Example: https://YOUR-DOMAIN.com/api/oauth/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Example: https://YOUR-DOMAIN.com/api/oauth/facebook/callback
FACEBOOK_REDIRECT_URI=
META_SCOPES=instagram_basic,instagram_manage_insights,pages_show_list,pages_read_engagement,pages_read_user_content
